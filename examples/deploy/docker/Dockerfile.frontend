# syntax=docker/dockerfile:1.7
# 前端静态产物镜像：构建阶段用 Node，运行阶段只带 Nginx 与 dist
# 构建上下文 = 前端仓库根目录；本文件可放在 deploy/docker/Dockerfile.frontend
# 使用非 root 镜像（默认 uid 101），监听 8080，由 Ingress / 边缘网关做 TLS 终结

ARG NODE_VERSION=22.12.0
ARG NGINX_VERSION=1.27.3-alpine

FROM node:${NODE_VERSION}-alpine AS build
WORKDIR /app
ENV CI=true

# 先只拷贝依赖清单：源码变动不会击穿依赖安装这一层缓存
COPY package.json pnpm-lock.yaml ./
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate \
    && pnpm install --frozen-lockfile

COPY . .

# 构建期变量：只放公开值；密钥一律运行时注入（见第 47 册）
ARG VITE_API_BASE=/api
ARG RELEASE=dev
ENV VITE_API_BASE=${VITE_API_BASE} \
    RELEASE=${RELEASE}

RUN pnpm build

FROM nginxinc/nginx-unprivileged:${NGINX_VERSION} AS runtime

# 容器内配置：与宿主机配置同源，去掉 TLS 与 80 端口监听
COPY deploy/nginx/container.conf /etc/nginx/conf.d/default.conf

# 只拷贝构建产物，不带 node_modules / 源码 / .git
COPY --from=build /app/dist /usr/share/nginx/html

# 版本标记：便于 curl /healthz 之外再用镜像标签核对发布版本
ARG RELEASE=dev
ENV RELEASE=${RELEASE}

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1

# 基础镜像已是非 root（uid 101）；显式声明防止被后续改动悄悄改回 root
USER 101

CMD ["nginx", "-g", "daemon off;"]
